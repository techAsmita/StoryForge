# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://storyforge:storyforge@localhost:5432/storyforge

# auto = real Gemini generation when GEMINI_API_KEY is set, demo (template) mode when it is empty.
LLM_PROVIDER=auto
GEMINI_API_KEY=
# Pick the model with the best free daily quota in AI Studio -> Rate limits (Flash-Lite models usually allow the most requests).
GEMINI_MODEL=gemini-3.5-flash-lite

# openai = OpenAI image model (best quality, paid per image, needs OPENAI_API_KEY)
# pollinations = free Flux images, placeholder = offline cards.
IMAGE_PROVIDER=pollinations
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# low (cheapest) | medium | high
OPENAI_IMAGE_QUALITY=medium
# Optional, free from enter.pollinations.ai (use a secret sk_ key). Without it, panels render one every ~46 s.
POLLINATIONS_API_KEY=
IMAGE_MIN_INTERVAL=46
IMAGE_SIZE=768

CORS_ORIGINS=http://localhost:5173
